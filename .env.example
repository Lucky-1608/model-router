# =============================================================================
# Universal AI Gateway — Environment Configuration (.env.example)
# Copy to .env for local development. NEVER commit real secrets to version control.
# =============================================================================

# Application Environment
GATEWAY_ENV=development
GATEWAY_APP_NAME="Universal AI Gateway"
GATEWAY_VERSION=0.1.0
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_FORMAT=json
GATEWAY_API_V1_PREFIX=/api/v1

# Security & Envelope Encryption
# 32-byte (256-bit) URL-safe base64-encoded Key Encryption Key (KEK).
# Generate one via: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GATEWAY_MASTER_KEK_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
GATEWAY_ADMIN_BOOTSTRAP_TOKEN=ugw_admin_dev_bootstrap_replace_me_in_prod
GATEWAY_STORE_PROMPTS=false
GATEWAY_ALLOW_LOCAL_HOSTS=localhost:11434,127.0.0.1:11434,ollama:11434

# PostgreSQL Configuration
GATEWAY_DATABASE_URL=postgresql+asyncpg://ugw_user:ugw_password@localhost:5432/universal_ai_gateway
GATEWAY_DB_POOL_SIZE=20
GATEWAY_DB_MAX_OVERFLOW=10
GATEWAY_DB_POOL_TIMEOUT_SECONDS=10.0
GATEWAY_DB_ECHO=false

# Redis Configuration
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_REDIS_MAX_CONNECTIONS=50
GATEWAY_REDIS_SOCKET_TIMEOUT_SECONDS=2.0
GATEWAY_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
GATEWAY_REDIS_FAIL_OPEN=true

# Upstream HTTPX Connection Pool & Timeout Settings
GATEWAY_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
GATEWAY_HTTP_READ_TIMEOUT_SECONDS=60.0
GATEWAY_HTTP_WRITE_TIMEOUT_SECONDS=15.0
GATEWAY_HTTP_POOL_TIMEOUT_SECONDS=5.0
GATEWAY_HTTP_MAX_CONNECTIONS=200
GATEWAY_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
GATEWAY_HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0

# Default Routing Weights (Must sum to 1.0)
GATEWAY_DEFAULT_WEIGHT_QUALITY=0.30
GATEWAY_DEFAULT_WEIGHT_RELIABILITY=0.25
GATEWAY_DEFAULT_WEIGHT_COST=0.20
GATEWAY_DEFAULT_WEIGHT_LATENCY=0.20
GATEWAY_DEFAULT_WEIGHT_CAPACITY=0.05

